# Copie para .env e preencha.

ACCESS_TOKEN=
USER_ID=

# Aplicacao em https://developers.mercadolivre.com.br/
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Opcional: mesma Redirect URI cadastrada na aplicacao (default abaixo)
MELI_REDIRECT_URI=http://127.0.0.1:8765/callback

# Preenchido automaticamente apos exchange-code ou refresh-tokens
MELI_REFRESH_TOKEN=

# Opcional: host de autorizacao (default Brasil)
# MELI_AUTH_BASE=https://auth.mercadolivre.com.br

# Opcional: escopos na URL de login (default pede refresh de longa duracao)
# MELI_OAUTH_SCOPE=offline_access read write
